.DS_Store

# Binaries (executable files, not directories)
/cli
/server
/cmd/cli/cli
/cmd/server/server

# Logs
**/logs/

# Config files with secrets
**/oauthClient*.json
**/drop_in_config*.yaml
drop_in_config.*.yaml
oauthClient.*.json
serviceAccount.*.json
.token.json
# The one exception: the dev environment holds no secrets and is committed, so
# a fresh checkout boots with no setup at all (docs/agents/dev-stack.md).
!drop_in_config.dev.yaml

# Any other secrets
*.secret
*.key

# OAuth tokens (stored in ~/.ilford-drop-in/tokens/ by default)
# Added here in case tokens are generated in project directory
.ilford-drop-in/
**/.ilford-drop-in/

# IDE
.vscode/
.idea/
# Python (pyallocator)
pyallocator/.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Claude local settings (holds agent secrets; keep ignored even if .claude is committed later)
.claude/settings.local.json

# Per-worktree environment written by scripts/worktree-init.sh
.worktree.env

# Worktrees live inside the checkout that owns them (docs/agents/worktrees.md).
# Each one carries its own go.mod, so `go build ./...` skips it; `git clean -xfd`
# skips it too, refusing to remove a directory another git repository manages.
/.worktrees/

# Droplet address for scripts/deploy-config.sh. Not a secret, but it is the
# maintainer's box rather than the repo's business.
.deploy.env
