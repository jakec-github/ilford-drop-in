{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": { "type": "string", "const": "ok" },
        "pattern": { "type": "string" }
      },
      "required": ["status", "pattern"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": { "type": "string", "const": "issues" },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "enum": ["missing", "ambiguous", "unsupported"] },
              "message": { "type": "string" },
              "examples": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["kind", "message", "examples"],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "issues"],
      "additionalProperties": false
    }
  ]
}
